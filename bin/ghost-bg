#!/usr/bin/env python3
"""Choose layered animated Ghostty landscapes."""

import argparse
import hashlib
import io
import json
import math
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(
    os.environ.get("GHOST_BG_DIR", str(Path.home() / ".config/ghostty"))
).expanduser()
CONFIG = ROOT / "config"
LIBRARY = ROOT / "backgrounds"
GHOSTTY = os.environ.get("GHOSTTY_BIN") or shutil.which("ghostty") or "/Applications/Ghostty.app/Contents/MacOS/ghostty"
SELF = str(Path(__file__).resolve())
MANAGED_SHADER = ROOT / "shaders/ghost-bg-city.glsl"
STATE = ROOT / ".ghost-bg-state.json"
DATA_DIR = Path(os.environ.get("GHOST_BG_DATA_DIR", str(Path.home() / ".local/share/ghost-bg"))).expanduser()
COLLECTION = DATA_DIR / "collection/index.html"
SCENE_NAMES = {"coast", "lake", "garden", "winter", "autumn", "rain", "desert", "tropical", "moon", "windmill", "city"}
MANAGED_SETTINGS = ("background-image-fit", "background-image-position", "custom-shader-animation")


def catalog():
    return json.loads((LIBRARY / "catalog.json").read_text())


def entry(name):
    entries = catalog()
    if name == "rain-live" and entries.get("rain", {}).get("animated"):
        name = "rain"
    if name not in entries:
        raise ValueError(f"Unknown background: {name}. Run ghost-bg list.")
    item = entries[name]
    image = (LIBRARY / item["file"]).resolve()
    if not image.is_file() or image.parent != LIBRARY.resolve():
        raise ValueError(f"Background image is missing: {image}")
    return item, image


def setting(text, key, default=""):
    matches = re.findall(r"^\s*" + re.escape(key) + r"\s*=\s*(.*?)\s*$", text, re.M)
    return matches[-1].strip('"') if matches else default


def status():
    text = CONFIG.read_text()
    path = setting(text, "background-image")
    name = next(
        (
            k
            for k, v in catalog().items()
            if path
            and (LIBRARY / v["file"]).resolve() == Path(path).expanduser().resolve()
        ),
        None,
    )
    return name, float(setting(text, "background-image-opacity", "0.18"))


def background_changes(name):
    item, path = entry(name)
    return {
        "background-image": str(path),
        "background-image-fit": "cover",
        "background-image-position": "center",
    }, bool(item.get("animated"))


def setting_state(text, key):
    matches = re.findall(r"^\s*" + re.escape(key) + r"\s*=\s*(.*?)\s*$", text, re.M)
    return {"present": bool(matches), "value": matches[-1] if matches else ""}


def write_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".ghost-bg-state-", dir=STATE.parent)
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(state, output, indent=2)
            output.write("\n")
        os.replace(temporary, STATE)
    finally:
        Path(temporary).unlink(missing_ok=True)


def managed_shader_line(line):
    if "=" not in line or line.split("=", 1)[0].strip() != "custom-shader":
        return False
    value = line.split("=", 1)[1].strip().strip('"')
    return (
        bool(value)
        and Path(value).expanduser().resolve().parent == MANAGED_SHADER.parent.resolve()
        and (match := re.fullmatch(r"ghost-bg-([a-z]+)(?:-[0-9a-f]{12})?\.glsl", Path(value).name))
        and match[1] in SCENE_NAMES
    )


def update(changes, animated=None):
    target = CONFIG.resolve()
    before = target.read_text()
    original_state = STATE.read_bytes() if STATE.exists() else None
    owns_settings = any(managed_shader_line(line) for line in before.splitlines())
    state = json.loads(original_state) if original_state is not None and owns_settings else None
    save_state = animated is True and state is None
    clear_state = animated is False and original_state is not None
    if save_state:
        state = {key: setting_state(before, key) for key in MANAGED_SETTINGS}
    if clear_state and state is not None:
        changes = dict(changes)
        for key, saved in state.items():
            changes[key] = saved["value"] if saved["present"] else None
    remaining = dict(changes)
    lines = []
    for line in before.splitlines():
        if animated is not None and managed_shader_line(line):
            continue
        key = line.split("=", 1)[0].strip() if "=" in line else ""
        if key in changes:
            if key in remaining:
                value = remaining.pop(key)
                if value is not None:
                    lines.append(f"{key} = {value}")
        else:
            lines.append(line)
    lines.extend(f"{k} = {v}" for k, v in remaining.items() if v is not None)
    if animated:
        lines.append(f"custom-shader = {MANAGED_SHADER}")
        if setting(before, "custom-shader-animation", "true") == "false":
            lines = [
                line
                for line in lines
                if not re.match(r"^\s*custom-shader-animation\s*=", line)
            ]
            lines.append("custom-shader-animation = true")
    after = "\n".join(lines) + "\n"
    shader_text = None
    shader_path = MANAGED_SHADER
    if any(managed_shader_line(line) for line in lines):
        image = setting(after, "background-image")
        selected = next(((key, item) for key, item in catalog().items() if image and (LIBRARY / item["file"]).resolve() == Path(image).expanduser().resolve()), None)
        if selected is None:
            raise ValueError("The managed animation has no matching background. Select a scene first.")
        scene_name, item = selected
        scene_name = "rain" if scene_name == "rain-live" else scene_name
        template = Path(item["shader_template"]).expanduser()
        opacity = float(setting(after, "background-opacity", "1"))
        if not 0 < opacity < 1:
            raise ValueError(
                "Animated backgrounds need background-opacity between 0 and 1 to protect terminal text."
            )
        strength = float(setting(after, "background-image-opacity", "0.18"))
        shader_text = (
            "// Generated by ghost-bg. Rebuild from the scene sources instead of editing.\n"
            f"const float STRENGTH = {strength:.6f};\n"
            f"const float BG_ALPHA = {opacity:.6f};\n" + template.read_text()
        )
    if shader_text is not None:
        # Ghostty 1.3.1 recompiles on path changes, not edits to the same shader.
        digest = hashlib.sha256(shader_text.encode()).hexdigest()[:12]
        shader_path = MANAGED_SHADER.with_name(f"ghost-bg-{scene_name}-{digest}.glsl")
        lines = [line for line in lines if not managed_shader_line(line)]
        lines.append(f"custom-shader = {shader_path}")
        after = "\n".join(lines) + "\n"
    if after == before and not (save_state or clear_state) and (
        shader_text is None
        or (shader_path.exists() and shader_path.read_text() == shader_text)
    ):
        print("Already saved. Reload Ghostty with Cmd+Shift+, if needed.")
        return
    fd, temporary = tempfile.mkstemp(
        prefix=".ghost-bg-", suffix=".conf", dir=target.parent
    )
    old_shader = shader_path.read_bytes() if shader_path.exists() else None
    shader_written = False
    committed = False
    try:
        if shader_text is not None:
            shader_path.parent.mkdir(parents=True, exist_ok=True)
            shader_fd, shader_temp = tempfile.mkstemp(
                prefix=".city-", dir=shader_path.parent
            )
            try:
                with os.fdopen(shader_fd, "w") as shader_file:
                    shader_file.write(shader_text)
                os.replace(shader_temp, shader_path)
                shader_written = True
            finally:
                Path(shader_temp).unlink(missing_ok=True)
        with os.fdopen(fd, "w") as f:
            f.write(after)
        os.chmod(temporary, target.stat().st_mode & 0o777)
        check = subprocess.run(
            [
                GHOSTTY,
                "+validate-config",
                f"--config-file={temporary}",
            ],
            capture_output=True,
            text=True,
        )
        if check.returncode or check.stdout.strip() or check.stderr.strip():
            raise ValueError(
                "Ghostty rejected the change: " + (check.stdout + check.stderr).strip()
            )
        if target.read_text() != before:
            raise ValueError("Config changed while saving. Please retry.")
        shutil.copy2(target, target.with_name("config.before-ghost-bg"))
        if save_state:
            write_state(state)
        elif clear_state:
            STATE.unlink(missing_ok=True)
        os.replace(temporary, target)
        committed = True
    finally:
        if shader_written and not committed:
            if old_shader is None:
                shader_path.unlink(missing_ok=True)
            else:
                shader_path.write_bytes(old_shader)
        if not committed:
            if original_state is None:
                STATE.unlink(missing_ok=True)
            else:
                STATE.write_bytes(original_state)
        Path(temporary).unlink(missing_ok=True)
    print("Saved. Press Cmd+Shift+, in Ghostty to apply to all windows.")


def preview_image(name, strength, sample_text=False):
    from PIL import Image, ImageDraw, ImageFont

    item, path = entry(name)
    if item.get("preview_file"):
        path = (LIBRARY / item["preview_file"]).resolve()
        if path.parent != LIBRARY.resolve():
            raise ValueError("Preview must be inside the background library")
    art = Image.open(path).convert("RGBA")
    art.thumbnail((1672, 1000))
    # Preview the configured artwork mix on Rose Pine Moon. Desktop glass
    # depends on the window underneath and cannot be reproduced here.
    base = Image.new("RGBA", art.size, "#232136")
    preview = Image.blend(base, Image.alpha_composite(base, art), strength).convert(
        "RGB"
    )
    if sample_text:
        draw = ImageDraw.Draw(preview)
        font = ImageFont.truetype("/System/Library/Fonts/Menlo.ttc", 22)
        for n, line in enumerate(
            [
                "~/projects  $ git status",
                "On branch main",
                "Your working tree is clean.",
                "",
                "Normal terminal text should remain easy to read.",
            ]
        ):
            draw.text((45, 45 + 34 * n), line, font=font, fill="#e0def4")
    return preview


def preview(name, full=False, detail=False):
    item, _ = entry(name)
    _, strength = status()
    if full and item.get("animated"):
        page = item["preview_path"]
        subprocess.run(["open", "-a", "Google Chrome", page], check=True)
        return
    if full:
        dest = Path.home() / ".cache/ghost-bg" / f"{name}-preview.png"
        dest.parent.mkdir(parents=True, exist_ok=True)
        preview_image(name, strength, True).save(dest)
        subprocess.run(["open", str(dest)], check=True)
        return
    columns = max(10, min(300, int(os.environ.get("FZF_PREVIEW_COLUMNS", "90"))))
    rows = max(4, min(120, int(os.environ.get("FZF_PREVIEW_LINES", "28"))) - 4)
    image = preview_image(name, 1.0 if detail else strength)
    data = io.BytesIO()
    image.save(data, format="PNG")
    print(
        item["title"]
        + (" - artwork detail" if detail else f" - strength {strength:.0%}")
    )
    print(item["description"])
    print("Ctrl-O: full-size preview with sample text", flush=True)
    subprocess.run(
        [
            "chafa",
            "--format=symbols",
            "--colors=full",
            "--symbols=block",
            "--probe=off",
            "--animate=off",
            "--bg=#232136",
            f"--size={columns}x{rows}",
            "-",
        ],
        input=data.getvalue(),
        check=True,
    )


def choose():
    if not sys.stdin.isatty():
        raise ValueError(
            "Run ghost-bg in an interactive terminal, or use ghost-bg list/use."
        )
    for dependency in ("fzf", "chafa"):
        if not shutil.which(dependency):
            raise ValueError(
                f"Missing {dependency}. Install with brew install fzf chafa."
            )
    current, strength = status()
    entries = catalog()
    rows = [
        f"{k}\t{v['title']}" + ("  [current]" if k == current else "")
        for k, v in entries.items()
    ]
    # fzf shell-quotes field placeholders; names are validated by entry().
    command = shlex.quote(SELF) + " preview {1}"
    args = [
        "fzf",
        "--no-multi",
        "--layout=reverse",
        "--border=rounded",
        "--info=inline",
        "--delimiter=\t",
        "--with-nth=2",
        "--prompt=Background > ",
        "--border-label= Ghostty backgrounds ",
        "--header=Arrows: browse | Enter: save | Esc: cancel\nCtrl-D: detail | Ctrl-S: actual strength | Ctrl-O: full size",
        "--preview=" + command,
        "--preview-window=right:70%:wrap",
        "--color=bg:#232136,bg+:#393552,fg:#e0def4,hl:#c4a7e7,hl+:#c4a7e7,pointer:#9ccfd8,border:#6e6a86",
        "--bind=ctrl-o:execute-silent(" + command + " --full)",
        "--bind=ctrl-d:change-preview(" + command + " --detail)",
        "--bind=ctrl-s:change-preview(" + command + ")",
    ]
    env = dict(
        os.environ, FZF_DEFAULT_OPTS="", FZF_DEFAULT_OPTS_FILE="", SHELL="/bin/sh"
    )
    result = subprocess.run(
        args, input="\n".join(rows), capture_output=True, text=True, env=env
    )
    if result.returncode in (1, 130):
        print("Cancelled. Background unchanged.")
        return
    if result.returncode:
        raise ValueError(result.stderr.strip() or "Background picker failed.")
    name = result.stdout.strip().split("\t")[0]
    changes, animated = background_changes(name)
    changes["background-image-opacity"] = f"{strength:.2f}"
    update(changes, animated)


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="Changes apply after Cmd+Shift+, in Ghostty. Animated city runs while the terminal is focused.",
    )
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("list", help="List available backgrounds and the current choice")
    sub.add_parser("pick", help="Choose with an interactive preview (the default)")
    sub.add_parser("gallery", help="Open all ten animated scenes for review")
    use = sub.add_parser("use", help="Choose by name")
    use.add_argument("name")
    strength = sub.add_parser(
        "strength", help="Set artwork opacity, 0-100; lower is quieter"
    )
    strength.add_argument("percent", type=float)
    prev = sub.add_parser("preview", help="Preview without changing the background")
    prev.add_argument("name")
    prev.add_argument(
        "--full",
        action="store_true",
        help="Open a full-size sample; animated scenes open in Chrome",
    )
    prev.add_argument(
        "--detail",
        action="store_true",
        help="Brighten only the preview to inspect the artwork",
    )
    sub.add_parser("off", help="Hide artwork while keeping your theme and glass")
    args = parser.parse_args()
    if args.command in (None, "pick"):
        choose()
    elif args.command == "gallery":
        subprocess.run(["open", "-a", "Google Chrome", str(COLLECTION)], check=True)
    elif args.command == "list":
        current, opacity = status()
        for key, item in catalog().items():
            print(f"{key:8} {item['title']}" + (" [current]" if key == current else ""))
        print(f"Artwork strength: {opacity:.0%}")
    elif args.command == "use":
        changes, animated = background_changes(args.name)
        update(changes, animated)
    elif args.command == "strength":
        if not math.isfinite(args.percent) or not 0 <= args.percent <= 100:
            parser.error("strength must be between 0 and 100")
        update({"background-image-opacity": f"{args.percent / 100:.2f}"})
    elif args.command == "preview":
        preview(args.name, args.full, args.detail)
    elif args.command == "off":
        update({"background-image": ""}, animated=False)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"ghost-bg: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
